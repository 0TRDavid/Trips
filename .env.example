# Copier en .env (jamais commité) puis adapter les valeurs.

# PostgreSQL
POSTGRES_DB=carnet
POSTGRES_USER=carnet
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.30.252,backend

# Nextcloud (utilisateur dédié, lecture seule sur les dossiers de voyage)
NEXTCLOUD_URL=https://nextcloud.exemple.lan
NEXTCLOUD_USER=carnet
NEXTCLOUD_PASSWORD=mot-de-passe-d-application

# Accès à l'API (toujours en lecture seule) : prive-reseau (Tailscale, v1) ou connecte (session requise)
API_ACCES=prive-reseau

# Recherche de lieux dans l'admin (Nominatim / OpenStreetMap) : contact facultatif
# ajouté au User-Agent, comme le demande leur politique d'usage (URL ou e-mail).
NOMINATIM_CONTACT=
